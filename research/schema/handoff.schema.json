{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent handoff",
  "description": "One worker agent's output for one product. Every claim carries a label; every FACT points at an evidence entry.",
  "type": "object",
  "required": ["product_id", "agent", "status", "summary", "facts", "estimates", "assumptions", "unknowns", "evidence", "flags", "recommendation", "limits_used"],
  "properties": {
    "product_id": {"type": "string", "pattern": "^P-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$"},
    "agent": {"type": "string", "enum": ["discovery", "competitor", "supplier", "economics"]},
    "status": {"type": "string", "enum": ["complete", "partial", "blocked"]},
    "summary": {"type": "string", "minLength": 20},
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "evidence_id"],
        "properties": {
          "claim": {"type": "string", "minLength": 3},
          "evidence_id": {"type": "string", "pattern": "^E-[0-9]{3,}$"}
        }
      }
    },
    "estimates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "method", "confidence"],
        "properties": {
          "claim": {"type": "string", "minLength": 3},
          "method": {"type": "string", "minLength": 3},
          "confidence": {"type": "string", "enum": ["low", "med", "high"]}
        }
      }
    },
    "assumptions": {"type": "array", "items": {"type": "string", "minLength": 3}},
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question", "why_unresolved"],
        "properties": {
          "question": {"type": "string", "minLength": 3},
          "why_unresolved": {"type": "string", "minLength": 3}
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "url", "accessed", "quote", "type"],
        "properties": {
          "id": {"type": "string", "pattern": "^E-[0-9]{3,}$"},
          "url": {"type": "string", "pattern": "^https?://"},
          "accessed": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "quote": {"type": "string", "maxLength": 300},
          "type": {"type": "string", "enum": ["marketplace", "search", "social", "ad_library", "forum", "supplier", "policy", "registry", "other"]},
          "verification": {"type": "string", "enum": ["VERIFIED", "SUPPLIER_CLAIM", "OBSERVED"]}
        }
      }
    },
    "flags": {
      "type": "array",
      "items": {"type": "string", "enum": ["IP_RISK", "SAFETY", "CLAIMS", "PLATFORM_POLICY", "OPS", "INJECTION_ATTEMPT", "SOURCE_UNAVAILABLE", "REQUIRES_SAMPLE", "SEASONAL", "HYPE"]}
    },
    "recommendation": {"type": "string", "enum": ["proceed", "proceed_with_conditions", "reject"]},
    "reject_reason": {"type": "string"},
    "limits_used": {
      "type": "object",
      "required": ["fetches", "searches", "minutes"],
      "properties": {
        "fetches": {"type": "integer"},
        "searches": {"type": "integer"},
        "minutes": {"type": "integer"}
      }
    },
    "data": {"type": "object", "description": "Agent-specific structured fields (supplier costs, scenarios, gates). See agent files."}
  }
}
