{
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Read",
      "Glob",
      "Grep",
      "Bash(python3 scripts/*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)"
    ],
    "deny": [
      "Bash(curl*)",
      "Bash(wget*)",
      "Bash(pip install*)",
      "Bash(pip3 install*)",
      "Bash(uv add*)",
      "Bash(uv pip*)",
      "Bash(npm install*)",
      "Bash(npm i *)",
      "Bash(npx *)",
      "Bash(claude mcp add*)",
      "Bash(git push*)",
      "Bash(rm -rf*)"
    ]
  }
}
